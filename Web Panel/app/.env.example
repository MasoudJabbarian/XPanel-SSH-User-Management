APP_NAME=XPanel SSH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_LOCALE=en
APP_MODE=light
PANEL_DIRECT=cp

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=XPanel
DB_USERNAME=
DB_PASSWORD=

PANEL_ADMIN_USERNAME=
PANEL_ADMIN_PASSWORD=

PORT_SSH=22
TRAFFIC_BASE=12
STATUS_LOG=deactive
ANTI_USER=active
CRON_TRAFFIC=active

LOG_CHANNEL=stack
